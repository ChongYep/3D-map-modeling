{
    "name": "long-march-digital-sandbox",
    "version": "1.0.0",
    "private": true,
    "description": "A 3D terrain sandbox of the Long March (1934-1935), built with Three.js.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:demo": "vite build && node scripts/sync-demo.mjs",
        "preview": "vite preview",
        "serve": "node server.js",
        "test:interaction": "node test-interaction.mjs",
        "test:responsive": "node test-responsive.mjs",
        "verify:offline": "node verify-offline.mjs",
        "shots": "node shoot-for-report.mjs"
    },
    "keywords": [
        "threejs",
        "webgl",
        "long-march",
        "china",
        "history",
        "education",
        "dataviz"
    ],
